<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\jajodex.ico</ApplicationIcon>
    <AssemblyName>JajoDex</AssemblyName>
    <RootNamespace>JajoDex</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>JajoDex</Product>
    <Company>yourcursedev</Company>
    <Authors>yourcursedev</Authors>
    <Description>JajoDex External Crosshair Overlay Studio</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredCompilation>true</TieredCompilation>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);JajoDex.Installer\**;Installer\**;publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\JajoDexLogo.png" />
    <Resource Include="Assets\JajoDexIcon.png" />
    <Resource Include="Assets\jajodex.ico" />
  </ItemGroup>

</Project>
